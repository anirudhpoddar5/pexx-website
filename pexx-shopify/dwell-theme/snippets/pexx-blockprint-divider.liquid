{%- comment -%}
  PEXX block-print repeat divider — the signature motif.
  A stamped buti border (madder diamond + indigo floret) that tiles edge-to-edge,
  echoing how the cloth itself is printed. Inline SVG <pattern>; decorative only.
{%- endcomment -%}
<div class="pexx-bp" role="presentation" style="width:100%;display:flex;justify-content:center;">
  <svg class="pexx-bp__svg" style="width:100%;max-width:1200px;height:30px;opacity:.92;" viewBox="0 0 1440 36" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="pexx-bp-{{ section.id }}" x="0" y="0" width="120" height="36" patternUnits="userSpaceOnUse">
        <g fill="none" stroke="#9E3B2F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M30 8 L42 18 L30 28 L18 18 Z"/>
          <path d="M30 13 L35 18 L30 23 L25 18 Z" stroke="#2B3A67"/>
        </g>
        <g fill="#2B3A67">
          <circle cx="90" cy="18" r="2.4"/>
          <circle cx="90" cy="11" r="1.5"/>
          <circle cx="90" cy="25" r="1.5"/>
          <circle cx="83" cy="18" r="1.5"/>
          <circle cx="97" cy="18" r="1.5"/>
        </g>
        <g fill="#9E3B2F">
          <circle cx="60" cy="18" r="1.3"/>
          <circle cx="0" cy="18" r="1.3"/>
          <circle cx="120" cy="18" r="1.3"/>
        </g>
      </pattern>
    </defs>
    <rect x="0" y="0" width="1440" height="36" fill="url(#pexx-bp-{{ section.id }})"/>
  </svg>
</div>

{% stylesheet %}
  .pexx-bp {
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .pexx-bp__svg {
    width: 100%;
    max-width: var(--page-width, 1200px);
    height: 30px;
    opacity: 0.92;
  }
  @media screen and (max-width: 749px) {
    .pexx-bp__svg { height: 24px; }
  }
{% endstylesheet %}
