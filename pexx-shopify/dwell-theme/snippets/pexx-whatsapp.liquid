{%- comment -%}
  PEXX floating WhatsApp button.
  ── EDIT THE NUMBER BELOW ──
  Use full international format, digits only (no +, spaces, or dashes).
  Example for India +91 98765 43210  →  919876543210
{%- endcomment -%}
{%- assign wa_number = '919660333911' -%}
{%- assign wa_message = 'Hi PEXX! I have a question about your hand block-printed pieces.' -%}

{%- if wa_number != '910000000000' -%}
  <a
    class="pexx-wa"
    href="https://wa.me/{{ wa_number }}?text={{ wa_message | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="Chat with PEXX on WhatsApp"
  >
    <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" focusable="false">
      <path fill="#fff" d="M16.04 4C9.96 4 5.02 8.94 5.02 15.02c0 1.94.51 3.84 1.48 5.52L4.94 27l6.6-1.73a11 11 0 0 0 4.5.96h.01c6.08 0 11.02-4.94 11.02-11.02C27.07 8.94 22.12 4 16.04 4Zm0 20.2h-.01a9.14 9.14 0 0 1-4.66-1.28l-.33-.2-3.92 1.03 1.05-3.82-.22-.34a9.13 9.13 0 0 1-1.4-4.86c0-5.05 4.11-9.16 9.17-9.16 2.45 0 4.75.96 6.48 2.69a9.1 9.1 0 0 1 2.68 6.48c0 5.06-4.11 9.17-9.16 9.17Zm5.03-6.86c-.27-.14-1.63-.8-1.88-.9-.25-.09-.43-.13-.62.14-.18.27-.71.9-.87 1.08-.16.18-.32.2-.59.07-.27-.14-1.16-.43-2.21-1.36-.82-.73-1.37-1.63-1.53-1.9-.16-.27-.02-.42.12-.55.12-.12.27-.32.41-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.62-1.49-.85-2.04-.22-.53-.45-.46-.62-.47-.16-.01-.34-.01-.53-.01-.18 0-.48.07-.73.34-.25.27-.96.94-.96 2.29 0 1.35.98 2.65 1.12 2.84.14.18 1.93 2.95 4.68 4.13.65.28 1.16.45 1.56.58.66.21 1.25.18 1.72.11.53-.08 1.63-.66 1.86-1.31.23-.64.23-1.19.16-1.31-.07-.12-.25-.18-.52-.32Z"/>
    </svg>
  </a>

  <style>
    .pexx-wa {
      position: fixed;
      bottom: 22px;
      right: 22px;
      z-index: 9998;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #25D366;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px rgba(0,0,0,.22);
      transition: transform .18s ease, box-shadow .18s ease;
    }
    .pexx-wa:hover {
      transform: scale(1.06);
      box-shadow: 0 6px 20px rgba(0,0,0,.28);
    }
    @media screen and (max-width: 749px) {
      .pexx-wa { bottom: 16px; right: 16px; width: 52px; height: 52px; }
    }
  </style>
{%- endif -%}
