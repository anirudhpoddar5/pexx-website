            "row_2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "<h3 style=\"margin:0;font:inherit;\">What fabric do you use?</h3>"
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<p>100% natural, breathable cotton, with no synthetic linings and no plastic-based ink layered over the print. It's soft from the first wash and softer with every wash after that.</p>"
